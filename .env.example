# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Environment
ENV=production

# Timezone (IANA format, e.g., Europe/Warsaw, America/New_York)
# Falls back to system timezone if not set
TIMEZONE=Europe/Warsaw

# MySQL Database Configuration
MYSQL_HOST=db
MYSQL_USER=root
MYSQL_PASSWD=your_secure_password_here
MYSQL_DATABASE=tirith_v1
MYSQL_ROOT_PASSWORD=your_secure_password_here

# Error logging
# In Docker, mount ./logs:/app/logs and use /app/logs/tirith-error.log
ERROR_LOG_FILE=./logs/tirith-error.log

# Toggl API Integration (Optional)
TOGGL_API_TOKEN=your_toggl_api_token_here
TOGGL_WORKSPACE_ID=your_workspace_id_here

# Telegram Pomodoro Notifications (Optional)
# TELEGRAM_CHAT_ID is optional: if empty, Tirith auto-discovers it from the
# latest Telegram update after you open your bot and send /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pomodoro Settings (Optional)
POMODORO_WORK_MINUTES=25
POMODORO_SHORT_BREAK_MINUTES=5
POMODORO_LONG_BREAK_MINUTES=20
POMODORO_BREAK_WARNING_SECONDS=30
